# ── Required ────────────────────────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/app/apikey
# Without it the server still runs: job search, contacts and client discovery
# are plain HTTP and work fine. Interviews, scoring and email drafting do not.
#
# The free tier is 20 requests PER DAY across the whole project. A single
# interview uses several. Add billing before showing this to anyone.
GEMINI_API_KEY=

# ── Deployment ──────────────────────────────────────────────────────────────
# Set to "production" when deployed. Enables rate limiting, hides internal
# error messages, and enforces the CORS allowlist below.
NODE_ENV=

# Comma-separated list of origins allowed to call this API, with no trailing
# slash, e.g. https://hireus.pages.dev,https://hireus.netlify.app
# In development any localhost port is allowed automatically.
# If this is unset in production the browser blocks every request.
CORS_ORIGIN=

# ── Optional ────────────────────────────────────────────────────────────────
# Adzuna job search: https://developer.adzuna.com/
# Without it the four free job boards still work; you lose regional listings.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter market code. Must be one Adzuna serves (gb, us, in, de, au, ...).
ADZUNA_COUNTRY=in

# GitHub's public API allows 60 requests/hour unauthenticated, which the
# company-contacts lookup exhausts quickly. A token with no scopes raises it
# to 5,000/hour: https://github.com/settings/tokens
GITHUB_TOKEN=

# Port the API listens on. Render and most hosts set this for you.
PORT=5001
