# Google AI Studio key: https://aistudio.google.com/app/apikey
# Without this the server still runs, but question generation and scoring fall
# back to fixed responses.
GEMINI_API_KEY=

# Adzuna job search API: https://developer.adzuna.com/
# Optional. The four free job boards work without it; Adzuna adds the regional
# (e.g. India) listings.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# two-letter Adzuna market code
ADZUNA_COUNTRY=in

# Optional. GitHub's public API allows 60 requests/hour unauthenticated, which
# the company-contacts lookup can exhaust quickly. A token (no scopes needed)
# raises the limit to 5,000/hour: https://github.com/settings/tokens
GITHUB_TOKEN=

# optional, defaults to 5001 (the client calls http://localhost:5001)
PORT=5001
